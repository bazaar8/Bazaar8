rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /portfolios/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{userId}/holdings/{holdingId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{userId}/watchlists/{watchlistId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /stocks/{stockId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /newsEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ipos/{ipoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /subscriptions/{subId} {
        allow read: if isAuthenticated() && (request.auth.uid == subId || isAdmin());
        allow write: if isAdmin();
      }
    }

    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /market/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /adminLogs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}